<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Erlaubt das Senden von AppleEvents (Finder-Ordner-Abfrage per
         osascript) unter Hardened Runtime. Ohne dieses Entitlement würde
         die für die Notarisierung nötige Hardened Runtime die Finder-
         Automation beider Apps blockieren. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
